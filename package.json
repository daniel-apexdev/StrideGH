{
  "name": "stride-gh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:seed-sql": "node scripts/generate-seed.mjs",
    "race:next": "node scripts/next-edition.mjs",
    "race:image": "node scripts/add-race-image.mjs",
    "notify": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/send-notifications.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "mobile": "npm --prefix mobile start",
    "email:test": "node scripts/send-test-email.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
