# Copy to .env and adjust. EXPO_PUBLIC_* values are baked into the app.

# Where the Stride GH API lives (the Next.js site in the folder above, /api).
# Leave unset in development: the app reuses your computer's LAN address
# (the one Expo shows) on port 3000, where `npm run dev` serves the site.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api

# Port of the website when EXPO_PUBLIC_API_URL is not set.
# EXPO_PUBLIC_API_PORT=3000

# Public address of the website, used for share links once it's deployed.
# EXPO_PUBLIC_SITE_URL=https://stridegh.example

# --- Using the GitHub Pages website (see README) ---
# EXPO_PUBLIC_API_URL=https://daniel-apexdev.github.io/StrideGH/api
# EXPO_PUBLIC_SITE_URL=https://daniel-apexdev.github.io/StrideGH
# Where "List your race" sends details when the website has no server:
# EXPO_PUBLIC_CONTACT_EMAIL=
# Accounts through Supabase (same project as the website). The anon key is meant to be public.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
