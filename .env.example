# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These two turn on website accounts (email codes). Races and shops still come from
# data/*.seed.json unless DATA_SOURCE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# files (default) or supabase
DATA_SOURCE=

# Server-only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
# Lets the admin portal save submissions and publish races in Supabase. Without it they're saved in data/local/.
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal (/admin). Both are required to sign in.
# SESSION_SECRET: any random text, at least 32 characters. Signs the admin cookie and protects
# account sign-in codes, so app accounts need it too.
ADMIN_PASSWORD=
SESSION_SECRET=

# Email (src/services/email). Gmail: use a Google App Password, not your normal password
# (Google Account → Security → 2-Step Verification → App passwords). Check with: npm run email:test -- you@example.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend instead of Gmail (better for a busy live site):
RESEND_API_KEY=
EMAIL_FROM=
# Where links in emails point. Set to your live domain when you deploy.
SITE_URL=http://localhost:3000
